NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Service-role key — bypasses RLS. Only ever used server-side, for code paths
# with no signed-in user to act on behalf of (see src/lib/supabase/admin.ts).
SUPABASE_SERVICE_ROLE_KEY=

# ── Email (Resend) ───────────────────────────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@edospmis.edoscentre.co.ke

# ── SMS (Africa's Talking) ───────────────────────────────────────────────────
# Optional per tenant — SLA/escalation and approval-required notifications can
# fire by SMS once configured; see ARCHITECTURE.md §9.
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=
